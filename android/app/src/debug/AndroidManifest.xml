<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only. This file is merged only into the debug build, so the RPC provider never ships
  in a release APK. The provider is exported so the Pechka app can reach it after the person
  approves this app's signing certificate in Settings.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name=".PechkaDebugProvider"
            android:authorities="${applicationId}.pechka.rpc"
            android:exported="true">
            <intent-filter>
                <action android:name="ai.pechka.action.APP_RPC" />
            </intent-filter>
        </provider>
    </application>
</manifest>
