# Non-code never enters the repository.
# Build output and binaries are published as release assets and fetched from there
# by the workflow runner, so a clone stays small and diffable.
dist/
assets/
*.zip
*.apk
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.ico
*.woff
*.woff2
*.pdf

# Android build output, and the bundle the APK is built from (it comes from the release).
android/.gradle/
android/build/
android/app/build/
android/app/src/main/assets/www/
android/local.properties

# One-off probe file from an earlier round.
extra.txt

# Downloaded media samples for testing editors. Local only: binaries stay out of the repo.
samples/
tooltest/data/beta.csv.enc
tt-pack.zip
tt-unpack/data/test.sqlite
tt-unpack/data/test.sqlite-journal
tt-unpack/stress/nulbyte.txt
tt-unpack/stress/nulbyte2.txt
selfcheck.zip
runlogs/0_build.txt
runlogs/build/3_Signing keystore (generated once, then reused).txt
runlogs/build/5_Android SDK.txt
runlogs/build/7_Build release APK.txt
runlogs2/0_build.txt
runlogs2/build/3_Signing keystore (generated once, then reused).txt
runlogs2/build/5_Android SDK.txt
runlogs2/build/7_Build release APK.txt
