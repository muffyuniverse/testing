// DeepSeek V4.1 Flash 1017 on OpenRouter, sent to PrimeIntellect and nothing else.
//
// Verified 14 Nov 2026 with a pinned 31-token request: HTTP 200, "provider": "PrimeIntellect",
// "service_tier": null, and reasoning came back (8 reasoning tokens, content null) so the agent
// loop works unchanged.
//
// Price measured on that probe: 43.7 micro-dollars per prompt token, 700 per completion token
// (0.00000135408 + 0.0000056 usd for 31 + 8 tokens). Of the four endpoints in this folder it is
// the cheapest input and the dearest output, which makes it the one to pick for a request that
// reads far more than it writes: a long transcript, a short answer.
//
// No service_tier: OpenRouter reports null for this endpoint, so naming "flex" or "default"
// here would be a claim about a tier it does not have, and the request would be refused rather
// than downgraded.
{
  "address": "https://openrouter.ai/api/v1",
  "url": "chat/completions",
  "key": "@openrouter",
  "target": 60000,
  "forget": 100000,
  "body": {
    "model": "deepseek/deepseek-v4.1-flash-1017",
    "messages": "{{messages}}",
    "tools": "{{tools}}",
    "tool_choice": "{{tool_choice}}",
    "stream": "{{stream}}",
    "stream_options": { "include_usage": true },
    "reasoning_effort": "high",
    "max_tokens": "{{max_tokens}}",
    // Downstream provider. "only" holds one slug, so no other provider can serve this request.
    // allow_fallbacks is false on purpose: a request fails rather than quietly being answered by
    // somebody else. Delete both lines to let OpenRouter route normally.
    "provider": {
      "only": ["primeintellect"],
      "allow_fallbacks": false
    }
  }
}
