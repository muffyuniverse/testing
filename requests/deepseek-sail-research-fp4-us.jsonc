// DeepSeek V4.1 Flash 1017 on OpenRouter, sent to Sail Research's fp4 endpoint in the US and
// nothing else. Same form as requests/deepseek-1017.jsonc; the only addition is the "provider"
// block at the end of the body.
//
// The endpoint is chosen by its OpenRouter slug: sail-research/fp4/us — Sail Research, fp4
// weights, and the "/us" variant the providers page labels "(US)". Sail Research also lists
// "sail-research/fp4" at the same price (72.72 micro-dollars per prompt token, 108 per completion
// token), so the "/us" suffix is the part that keeps this request on the US endpoint; dropping it
// would let the sibling endpoint answer instead.
//
// There is no service_tier here: OpenRouter reports none for either Sail Research endpoint
// ("service_tier": null in the endpoint data), so naming "flex" or "default" would be a claim
// about a tier this endpoint does not have.
{
  "address": "https://openrouter.ai/api/v1",
  "url": "chat/completions",
  "key": "@openrouter",
  "target": 60000,
  "forget": 100000,
  "body": {
    "model": "deepseek/deepseek-v4.1-flash-1017",
    "messages": "{{messages}}",
    "tools": "{{tools}}",
    "tool_choice": "{{tool_choice}}",
    "stream": "{{stream}}",
    "stream_options": { "include_usage": true },
    "reasoning_effort": "high",
    "max_tokens": "{{max_tokens}}",
    // Downstream provider. "only" holds one slug, so no other provider can serve this request.
    // allow_fallbacks is false on purpose: a request fails rather than quietly being answered by
    // the sibling sail-research/fp4 endpoint or by another provider entirely. Delete both lines
    // to let OpenRouter route normally.
    "provider": {
      "only": ["sail-research/fp4/us"],
      "allow_fallbacks": false
    }
  }
}
