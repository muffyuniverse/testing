// DeepSeek V4.1 Flash 1017 on OpenRouter, sent to DeepInfra's standard endpoint and nothing else.
//
// The pair to this file is requests/deepseek-deepinfra-flex.jsonc: same provider, same weights,
// different service tier. This one buys the answer; that one buys the price.
//
// Verified 14 Nov 2026 with a pinned 31-token request: HTTP 200, "provider": "DeepInfra",
// "service_tier": "default". Price measured on that same probe: 98 micro-dollars per prompt
// token and 294 per completion token (0.000003038 + 0.000002352 usd for 31 + 8 tokens).
//
// The slug "deepinfra" matches the standard and turbo rows, never a tier row, so flex is not
// reachable from here and standard is not reachable from the flex form.
{
  "address": "https://openrouter.ai/api/v1",
  "url": "chat/completions",
  "key": "@openrouter",
  "target": 60000,
  "forget": 100000,
  "body": {
    "model": "deepseek/deepseek-v4.1-flash-1017",
    "messages": "{{messages}}",
    "tools": "{{tools}}",
    "tool_choice": "{{tool_choice}}",
    "stream": "{{stream}}",
    "stream_options": { "include_usage": true },
    "reasoning_effort": "high",
    "max_tokens": "{{max_tokens}}",
    // Downstream provider. "only" holds one slug, so no other provider can serve this request.
    // allow_fallbacks is false on purpose: a request fails rather than quietly being answered by
    // DeepInfra's flex row or by another provider entirely. Delete both lines to let OpenRouter
    // route normally.
    "provider": {
      "only": ["deepinfra"],
      "allow_fallbacks": false
    },
    // Named for symmetry with the flex form, where the tier is the whole point. OpenRouter
    // answers "default" for this slug, so this line states what the router would choose anyway.
    "service_tier": "default"
  }
}
