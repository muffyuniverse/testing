// DeepSeek V4.1 Flash 1017 on OpenRouter, sent to StepFun's fp8 endpoint and nothing else.
//
// Verified 14 Nov 2026 with a pinned 31-token request: HTTP 200, "provider": "StepFun",
// "service_tier": null, reasoning came back (8 reasoning tokens, content null).
//
// Price measured on that probe: 105 micro-dollars per prompt token, 420 per completion token
// (0.000003255 + 0.00000336 usd for 31 + 8 tokens). Sits between PrimeIntellect and DeepInfra
// standard on both sides of the ledger.
//
// About the suffix: the bare slug "stepfun" and "stepfun/fp8" both answer 200 with the same
// provider and the same measured price, so /fp8 names a peer row rather than a different
// machine. This form pins the suffixed one because it says which weights answer.
//
// No service_tier: OpenRouter reports null here, so naming a tier would be a claim about a tier
// this endpoint does not have.
{
  "address": "https://openrouter.ai/api/v1",
  "url": "chat/completions",
  "key": "@openrouter",
  "target": 60000,
  "forget": 100000,
  "body": {
    "model": "deepseek/deepseek-v4.1-flash-1017",
    "messages": "{{messages}}",
    "tools": "{{tools}}",
    "tool_choice": "{{tool_choice}}",
    "stream": "{{stream}}",
    "stream_options": { "include_usage": true },
    "reasoning_effort": "high",
    "max_tokens": "{{max_tokens}}",
    // Downstream provider. "only" holds one slug, so no other provider can serve this request.
    // allow_fallbacks is false on purpose: a request fails rather than quietly being answered by
    // StepFun's bare row or by another provider entirely.
    "provider": {
      "only": ["stepfun/fp8"],
      "allow_fallbacks": false
    }
  }
}
